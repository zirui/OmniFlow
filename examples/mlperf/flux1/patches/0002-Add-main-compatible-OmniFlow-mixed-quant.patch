+__device__ __forceinline__ void compute_mxfp8_e4m3_tile_scale(float r_amax, float &r_scale_native,
+                                                              uint8_t &r_scale_e8m0) {
+    constexpr int  hp_mbits           = FP32_MANTISSA_BITS;
+    constexpr int  hp_ebits           = FP32_EXPONENT_BITS;
+    constexpr int  hp_exp_bias        = FP32_EXPONENT_EXP_BIAS;
+    constexpr int  e8m0_exponent_bias = E8M0_EXPONENT_BIAS;
+    constexpr int  val_to_add         = 1 << (hp_mbits - FP8E4M3_MANTISSA_BITS - 1);
+    constexpr int  hp_exp_mask        = (1 << (hp_ebits + 1)) - 1;
+    const uint32_t amax_bits          = float_as_uint(r_amax);
+    int scale_e8m0_unbiased = (((amax_bits + val_to_add) >> hp_mbits) & hp_exp_mask) - hp_exp_bias -
+                              FP8E4M3_TARGET_MAX_POW2;
+    scale_e8m0_unbiased =
+        scale_e8m0_unbiased > -e8m0_exponent_bias ? scale_e8m0_unbiased : -e8m0_exponent_bias;
+    scale_e8m0_unbiased = scale_e8m0_unbiased < (e8m0_exponent_bias + 1) ? scale_e8m0_unbiased
+                                                                         : (e8m0_exponent_bias + 1);
+    const int scale_e8m0_biased = scale_e8m0_unbiased + e8m0_exponent_bias;
+    r_scale_e8m0                = static_cast<uint8_t>(scale_e8m0_biased);
+    r_scale_native = uint_as_float(static_cast<uint32_t>(scale_e8m0_biased) << hp_mbits);
+}
+
+__device__ __forceinline__ uint32_t cvt_f32x4_to_fp8e4m3x4(float v0, float v1, float v2, float v3,
+                                                           float scale) {
+    const float lim = FP8E4M3_MAX * scale;
+    v0              = fminf(fmaxf(v0, -lim), lim);
+    v1              = fminf(fmaxf(v1, -lim), lim);
+    v2              = fminf(fmaxf(v2, -lim), lim);
+    v3              = fminf(fmaxf(v3, -lim), lim);
+#if defined(__gfx950__)
+    uint16_t low = 0;
+    asm volatile("v_cvt_scalef32_pk_fp8_f32 %0, %1, %2, %3"
+                 : "+v"(low)
+                 : "v"(v0), "v"(v1), "v"(scale));
+    uint16_t high = 0;
+    asm volatile("v_cvt_scalef32_pk_fp8_f32 %0, %1, %2, %3"
+                 : "+v"(high)
+                 : "v"(v2), "v"(v3), "v"(scale));
+    return (static_cast<uint32_t>(high) << 16) | low;
+#elif defined(__gfx1250__)
+    typedef float     float32x8_t __attribute__((ext_vector_type(8)));
+    typedef uint32_t  uint32x2_t __attribute__((ext_vector_type(2)));
+    const float32x8_t values = {v0, v1, v2, v3, 0.f, 0.f, 0.f, 0.f};
+    const uint32x2_t  packed = __builtin_amdgcn_cvt_scalef32_pk8_fp8_f32(values, scale);
+    return packed[0];
+#else
+    __builtin_trap();
+    return 0;
+#endif
+}
