+// Quantize rowwise MXFP8 E4M3 and colwise MXFP4 E2M1 in one input pass.
+std::vector<at::Tensor> quantize_mxfp8_rowwise_mxfp4_colwise(const at::Tensor input,
+                                                             const bool rowwise_fp8_use_2d_block,
+                                                             const bool colwise_fp4_use_2d_block,
+                                                             const bool colwise_fp4_use_rht,
+                                                             const bool shuffle_colwise_scale,
+                                                             const bool shuffle_colwise) {
+    using namespace primus_turbo::detail;
+
+    PRIMUS_TURBO_CHECK(input.is_cuda(), "Input must be a CUDA tensor");
+    PRIMUS_TURBO_CHECK(input.scalar_type() == at::kBFloat16 || input.scalar_type() == at::kHalf,
+                       "Input must be BFloat16 or Half");
+    PRIMUS_TURBO_CHECK(input.dim() == 2, "Input must be 2D");
+    PRIMUS_TURBO_CHECK(input.is_contiguous(), "Input must be contiguous");
+
+    const int64_t M     = input.size(0);
+    const int64_t N     = input.size(1);
+    const int64_t M_pad = cdiv(M, MXFP4_K_DIM_PADDING_ALIGN_SIZE) * MXFP4_K_DIM_PADDING_ALIGN_SIZE;
+    const int64_t N_pad = cdiv(N, MXFP8_K_DIM_PADDING_ALIGN_SIZE) * MXFP8_K_DIM_PADDING_ALIGN_SIZE;
+    PRIMUS_TURBO_CHECK(N % MXFP4_BLOCK_SIZE == 0, "N must be divisible by ", MXFP4_BLOCK_SIZE);
+    if (shuffle_colwise) {
+        PRIMUS_TURBO_CHECK(N % MXFP4_SHUFFLE_BN == 0, "N must be divisible by ", MXFP4_SHUFFLE_BN,
+                           " for shuffled colwise FP4. But got N=", N);
+    }
+
+    auto device = input.device();
+    auto stream = at::cuda::getCurrentCUDAStream();
+
+    const int64_t rowwise_scale_N = cdiv(N_pad, MXFP8_BLOCK_SIZE);
+    at::Tensor    rowwise_output =
+        at::empty({M, N_pad}, at::TensorOptions().dtype(at::kByte).device(device));
+    at::Tensor rowwise_scale =
+        at::empty({M, rowwise_scale_N}, at::TensorOptions().dtype(at::kByte).device(device));
+
+    const int64_t colwise_scale_M_pad = cdiv(N, 256) * 256;
+    const int64_t colwise_scale_N     = cdiv(M_pad, MXFP4_BLOCK_SIZE);
+    const int64_t colwise_scale_N_pad = cdiv(colwise_scale_N, 8) * 8;
+    at::Tensor    colwise_scale;
+    if (shuffle_colwise_scale) {
