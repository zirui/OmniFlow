+std::vector<at::Tensor> quantize_mxfp8_rowwise_mxfp4_colwise_meta(
+    const at::Tensor input, const bool rowwise_fp8_use_2d_block,
+    const bool colwise_fp4_use_2d_block, const bool colwise_fp4_use_rht,
+    const bool shuffle_colwise_scale, const bool shuffle_colwise) {
+    using namespace primus_turbo::detail;
+
+    auto cdiv = [](int64_t a, int64_t b) -> int64_t { return (a + b - 1) / b; };
+    PRIMUS_TURBO_CHECK(input.scalar_type() == at::kBFloat16 || input.scalar_type() == at::kHalf,
+                       "Input must be BFloat16 or Half");
+    PRIMUS_TURBO_CHECK(input.dim() == 2, "Input must be 2D");
+    PRIMUS_TURBO_CHECK(input.is_contiguous(), "Input must be contiguous");
+
+    const int64_t M     = input.size(0);
+    const int64_t N     = input.size(1);
+    const int64_t M_pad = cdiv(M, MXFP4_K_DIM_PADDING_ALIGN_SIZE) * MXFP4_K_DIM_PADDING_ALIGN_SIZE;
+    const int64_t N_pad = cdiv(N, MXFP8_K_DIM_PADDING_ALIGN_SIZE) * MXFP8_K_DIM_PADDING_ALIGN_SIZE;
+    PRIMUS_TURBO_CHECK(N % MXFP4_BLOCK_SIZE == 0, "N must be divisible by ", MXFP4_BLOCK_SIZE);
+    if (shuffle_colwise) {
+        PRIMUS_TURBO_CHECK(N % MXFP4_SHUFFLE_BN == 0,
+                           "N must be divisible by 16 for shuffled colwise FP4");
+    }
+
+    const int64_t rowwise_scale_N     = cdiv(N_pad, MXFP8_BLOCK_SIZE);
+    const int64_t colwise_scale_M_pad = cdiv(N, 256) * 256;
+    const int64_t colwise_scale_N     = cdiv(M_pad, MXFP4_BLOCK_SIZE);
+    const int64_t colwise_scale_N_pad = cdiv(colwise_scale_N, 8) * 8;
+    const int64_t colwise_scale_rows  = shuffle_colwise_scale ? colwise_scale_M_pad : N;
+    const int64_t colwise_scale_columns =
+        shuffle_colwise_scale ? colwise_scale_N_pad : colwise_scale_N;
+    auto options = at::TensorOptions().dtype(at::kByte).device(at::kMeta);
+
+    return {
+        at::empty({M, N_pad}, options).view(at::kFloat8_e4m3fn),
+        at::empty({M, rowwise_scale_N}, options).view(at::kFloat8_e8m0fnu),
+        at::empty({N, M_pad / 2}, options).view(at::kFloat4_e2m1fn_x2),
+        at::empty({colwise_scale_rows, colwise_scale_columns}, options).view(at::kFloat8_e8m0fnu)};
+}
