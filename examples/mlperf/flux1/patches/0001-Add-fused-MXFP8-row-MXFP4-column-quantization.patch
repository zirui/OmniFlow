+def test_quantize_mxfp8_rowwise_mxfp4_colwise_matches_independent_ops(
+    orig_dtype, M, N, row_2d, col_2d, col_rht, shuffle_scale, shuffle_data
+):
+    mxfp4_supported, reason = check_mxfp4_support()
+    if not mxfp4_supported:
+        pytest.skip(reason)
+
+    torch.manual_seed(42)
+    x = torch.randn((M, N), device="cuda", dtype=orig_dtype)
+    actual = torch.ops.primus_turbo_cpp_extension.quantize_mxfp8_rowwise_mxfp4_colwise(
+        x, row_2d, col_2d, col_rht, shuffle_scale, shuffle_data
+    )
+    fp8_ref = torch.ops.primus_turbo_cpp_extension.quantize_mxfp8(
+        x, torch.float8_e4m3fn, 1, 128, row_2d, False, False
+    )
+    fp4_dual_ref = torch.ops.primus_turbo_cpp_extension.quantize_mxfp4_dual(
+        x,
+        turbo.float4_e2m1fn_x2,
+        128,
+        False,
+        False,
