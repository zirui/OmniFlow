 template <typename DType>
 void quantize_mxfp4_impl(const DType *input, dtype::float4x2_e2m1 *output, uint8_t *scale,
                          detail::QuantizeMode mode, int G, int M, int N, int M_pad, int N_pad,
diff --git a/csrc/kernels/quantization/quantization_mxfp4.cu b/csrc/kernels/quantization/quantization_mxfp4.cu
index 67c25928..a6694d48 100644
--- a/csrc/kernels/quantization/quantization_mxfp4.cu
+++ b/csrc/kernels/quantization/quantization_mxfp4.cu
@@ -180,6 +180,55 @@ __device__ __forceinline__ void compute_tile_scale(float r_amax, float &r_scale_
     r_scale_native = uint_as_float((uint32_t) scale_e8m0_biased << hp_mbits);
 }
 
+__device__ __forceinline__ void compute_mxfp8_e4m3_tile_scale(float r_amax, float &r_scale_native,
+                                                              uint8_t &r_scale_e8m0) {
+    constexpr int  hp_mbits           = FP32_MANTISSA_BITS;
+    constexpr int  hp_ebits           = FP32_EXPONENT_BITS;
+    constexpr int  hp_exp_bias        = FP32_EXPONENT_EXP_BIAS;
+    constexpr int  e8m0_exponent_bias = E8M0_EXPONENT_BIAS;
+    constexpr int  val_to_add         = 1 << (hp_mbits - FP8E4M3_MANTISSA_BITS - 1);
+    constexpr int  hp_exp_mask        = (1 << (hp_ebits + 1)) - 1;
+    const uint32_t amax_bits          = float_as_uint(r_amax);
+    int scale_e8m0_unbiased = (((amax_bits + val_to_add) >> hp_mbits) & hp_exp_mask) - hp_exp_bias -
+                              FP8E4M3_TARGET_MAX_POW2;
+    scale_e8m0_unbiased =
+        scale_e8m0_unbiased > -e8m0_exponent_bias ? scale_e8m0_unbiased : -e8m0_exponent_bias;
+    scale_e8m0_unbiased = scale_e8m0_unbiased < (e8m0_exponent_bias + 1) ? scale_e8m0_unbiased
+                                                                         : (e8m0_exponent_bias + 1);
+    const int scale_e8m0_biased = scale_e8m0_unbiased + e8m0_exponent_bias;
+    r_scale_e8m0                = static_cast<uint8_t>(scale_e8m0_biased);
+    r_scale_native = uint_as_float(static_cast<uint32_t>(scale_e8m0_biased) << hp_mbits);
+}
+
+__device__ __forceinline__ uint32_t cvt_f32x4_to_fp8e4m3x4(float v0, float v1, float v2, float v3,
+                                                           float scale) {
+    const float lim = FP8E4M3_MAX * scale;
+    v0              = fminf(fmaxf(v0, -lim), lim);
+    v1              = fminf(fmaxf(v1, -lim), lim);
+    v2              = fminf(fmaxf(v2, -lim), lim);
+    v3              = fminf(fmaxf(v3, -lim), lim);
+#if defined(__gfx950__)
+    uint16_t low = 0;
+    asm volatile("v_cvt_scalef32_pk_fp8_f32 %0, %1, %2, %3"
+                 : "+v"(low)
+                 : "v"(v0), "v"(v1), "v"(scale));
+    uint16_t high = 0;
+    asm volatile("v_cvt_scalef32_pk_fp8_f32 %0, %1, %2, %3"
+                 : "+v"(high)
+                 : "v"(v2), "v"(v3), "v"(scale));
+    return (static_cast<uint32_t>(high) << 16) | low;
+#elif defined(__gfx1250__)
+    typedef float     float32x8_t __attribute__((ext_vector_type(8)));
+    typedef uint32_t  uint32x2_t __attribute__((ext_vector_type(2)));
+    const float32x8_t values = {v0, v1, v2, v3, 0.f, 0.f, 0.f, 0.f};
+    const uint32x2_t  packed = __builtin_amdgcn_cvt_scalef32_pk8_fp8_f32(values, scale);
+    return packed[0];
+#else
+    __builtin_trap();
+    return 0;
+#endif
+}
+
 /*
  * FP32 to FP4 Conversion
  * ----------------------
@@ -639,7 +688,7 @@ __global__ __launch_bounds__(THREADS_PER_BLOCK, 4) void quantize_mxfp4_kernel(
  */
 template <typename DType, bool ROWWISE_USE_RHT = false, bool COLWISE_USE_RHT = false,
           bool ROWWISE_USE_2D_BLOCK = false, bool COLWISE_USE_2D_BLOCK = false,
-          bool ROWWISE_USE_SR = false, bool COLWISE_USE_SR = false>
+          bool ROWWISE_USE_SR = false, bool COLWISE_USE_SR = false, bool ROWWISE_MXFP8 = false>
 __global__ __launch_bounds__(THREADS_PER_BLOCK, 4) void quantize_mxfp4_dual_kernel(
     const DType *__restrict__ input_base, uint8_t *__restrict__ rowwise_fp4_base,
     uint8_t *__restrict__ rowwise_scale_base, uint8_t *__restrict__ colwise_fp4_base,
@@ -687,8 +736,8 @@ __global__ __launch_bounds__(THREADS_PER_BLOCK, 4) void quantize_mxfp4_dual_kern
     const int base_m = block_m * BLOCK_M;
     const int base_n = block_n * BLOCK_N;
 
-    // Packed dimensions (2 FP4 values per byte), using padded sizes for output stride
-    const int K_packed = N_pad / 2;
+    // The mixed mode stores one FP8 byte per rowwise element; FP4 remains packed.
+    const int K_packed = ROWWISE_MXFP8 ? N_pad : N_pad / 2;
     const int M_packed = M_pad / 2;
 
     constexpr int ROWS_PER_PASS   = WARP_SIZE / THREADS_PER_ROW;
@@ -839,7 +888,11 @@ __global__ __launch_bounds__(THREADS_PER_BLOCK, 4) void quantize_mxfp4_dual_kern
             tile_amax = warp_reduce_max_64_dpp(tile_amax);
             float   r_scale_native;
             uint8_t r_scale_e8m0;
-            compute_tile_scale(tile_amax, r_scale_native, r_scale_e8m0);
+            if constexpr (ROWWISE_MXFP8) {
+                compute_mxfp8_e4m3_tile_scale(tile_amax, r_scale_native, r_scale_e8m0);
+            } else {
+                compute_tile_scale(tile_amax, r_scale_native, r_scale_e8m0);
+            }
 #pragma unroll
             for (int p = 0; p < PASSES_PER_TILE; p++) {
                 r_rowwise_scale_native[p] = r_scale_native;
@@ -847,14 +900,20 @@ __global__ __launch_bounds__(THREADS_PER_BLOCK, 4) void quantize_mxfp4_dual_kern
             }
         } else {
 #pragma unroll
-            for (int p = 0; p < PASSES_PER_TILE; p++)
-                compute_tile_scale(r_rowwise_amax[p], r_rowwise_scale_native[p],
-                                   r_rowwise_scale_e8m0[p]);
+            for (int p = 0; p < PASSES_PER_TILE; p++) {
+                if constexpr (ROWWISE_MXFP8) {
+                    compute_mxfp8_e4m3_tile_scale(r_rowwise_amax[p], r_rowwise_scale_native[p],
+                                                  r_rowwise_scale_e8m0[p]);
+                } else {
+                    compute_tile_scale(r_rowwise_amax[p], r_rowwise_scale_native[p],
+                                       r_rowwise_scale_e8m0[p]);
+                }
+            }
         }
 
         // ================================================================
         // Rowwise Quantization (Horizantal Processing)
-        // Step 3: Quantize from regs + Store FP4 / Scale
+        // Step 3: Quantize from regs + Store FP8 or FP4 / Scale
         // ================================================================
         {
             const int col_base   = thread_in_row * ELEMS_PER_THREAD;
@@ -867,29 +926,41 @@ __global__ __launch_bounds__(THREADS_PER_BLOCK, 4) void quantize_mxfp4_dual_kern
                 const int global_row = tile_m + local_row;
 
                 if (global_row < M) {
-                    uint16_t fp4x4;
-                    // Convert packed FP32 to FP4
-                    if constexpr (ROWWISE_USE_SR) {
-                        uint32_t rng = sr_hash(sr_seed ^ (blockDim.x * blockIdx.x + threadIdx.x));
-                        fp4x4 =
-                            cvt_f32x4_to_fp4x4_sr(r_rowwise_vals[pass][0], r_rowwise_vals[pass][1],
-                                                  r_rowwise_vals[pass][2], r_rowwise_vals[pass][3],
-                                                  r_rowwise_scale_native[pass], rng);
+                    if constexpr (ROWWISE_MXFP8) {
+                        const uint32_t fp8x4 =
+                            cvt_f32x4_to_fp8e4m3x4(r_rowwise_vals[pass][0], r_rowwise_vals[pass][1],
+                                                   r_rowwise_vals[pass][2], r_rowwise_vals[pass][3],
+                                                   r_rowwise_scale_native[pass]);
+                        if (global_col < N_pad) {
+                            *reinterpret_cast<uint32_t *>(rowwise_fp4 + global_row * K_packed +
+                                                          global_col) = fp8x4;
+                        }
                     } else {
-                        fp4x4 = cvt_f32x4_to_fp4x4(r_rowwise_vals[pass][0], r_rowwise_vals[pass][1],
+                        uint16_t fp4x4;
+                        if constexpr (ROWWISE_USE_SR) {
+                            uint32_t rng =
+                                sr_hash(sr_seed ^ (blockDim.x * blockIdx.x + threadIdx.x));
+                            fp4x4 = cvt_f32x4_to_fp4x4_sr(
+                                r_rowwise_vals[pass][0], r_rowwise_vals[pass][1],
+                                r_rowwise_vals[pass][2], r_rowwise_vals[pass][3],
+                                r_rowwise_scale_native[pass], rng);
+                        } else {
+                            fp4x4 =
+                                cvt_f32x4_to_fp4x4(r_rowwise_vals[pass][0], r_rowwise_vals[pass][1],
                                                    r_rowwise_vals[pass][2], r_rowwise_vals[pass][3],
                                                    r_rowwise_scale_native[pass]);
-                    }
+                        }
 
-                    if (global_col < N_pad) {
-                        if (shuffle_rowwise) {
-                            int packed_col   = global_col / 2;
-                            int shuffled_idx = compute_shuffled_index<dtype::float4x2_e2m1>(
-                                global_row, packed_col, K_packed);
-                            *reinterpret_cast<uint16_t *>(rowwise_fp4 + shuffled_idx) = fp4x4;
-                        } else {
-                            *reinterpret_cast<uint16_t *>(rowwise_fp4 + global_row * K_packed +
-                                                          global_col / 2) = fp4x4;
+                        if (global_col < N_pad) {
+                            if (shuffle_rowwise) {
+                                int packed_col   = global_col / 2;
+                                int shuffled_idx = compute_shuffled_index<dtype::float4x2_e2m1>(
+                                    global_row, packed_col, K_packed);
+                                *reinterpret_cast<uint16_t *>(rowwise_fp4 + shuffled_idx) = fp4x4;
+                            } else {
+                                *reinterpret_cast<uint16_t *>(rowwise_fp4 + global_row * K_packed +
+                                                              global_col / 2) = fp4x4;
+                            }
                         }
                     }
 
@@ -1242,6 +1313,71 @@ template void quantize_mxfp4_dual_impl<dtype::bfloat16>(
     int colwise_scale_M_pad, int colwise_scale_N_pad, ScalingRecipe rowwise_recipe,
     ScalingRecipe colwise_recipe, hipStream_t stream);
 
+template <typename DType>
+void quantize_mxfp8_rowwise_mxfp4_colwise_impl(
+    const DType *input, dtype::float8_e4m3 *rowwise_output, uint8_t *rowwise_scale,
+    dtype::float4x2_e2m1 *colwise_output, uint8_t *colwise_scale, int M, int N, int M_pad,
+    int N_pad, int rowwise_scale_stride, int colwise_scale_stride, int rowwise_scale_N,
+    int colwise_scale_N, int colwise_scale_M_pad, int colwise_scale_N_pad,
+    ScalingRecipe rowwise_recipe, ScalingRecipe colwise_recipe, hipStream_t stream) {
+    dim3           grid((M_pad + BLOCK_M - 1) / BLOCK_M, (N_pad + BLOCK_N - 1) / BLOCK_N);
+    dim3           block(warp_size() * WARPS_PER_BLOCK);
+    const uint32_t sr_seed = 0;
+
+#define QUANTIZE_MXFP8_ROW_MXFP4_COL_ARGS                                                          \
+    input, reinterpret_cast<uint8_t *>(rowwise_output), rowwise_scale,                             \
+        reinterpret_cast<uint8_t *>(colwise_output), colwise_scale, M, N, M_pad, N_pad,            \
+        rowwise_scale_stride, colwise_scale_stride, rowwise_scale_N, M, rowwise_scale_N, N,        \
+        colwise_scale_N, colwise_scale_M_pad, colwise_scale_N_pad, false,                          \
+        colwise_recipe.shuffle_out, false, colwise_recipe.shuffle_scale, sr_seed
+
+#define QUANTIZE_MXFP8_ROW_MXFP4_COL_LAUNCH(ROW_2D, COL_2D, COL_RHT)                               \
+    quantize_mxfp4_dual_kernel<DType, false, COL_RHT, ROW_2D, COL_2D, false, false, true>          \
+        <<<grid, block, 0, stream>>>(QUANTIZE_MXFP8_ROW_MXFP4_COL_ARGS)
+
+    if (rowwise_recipe.use_2d_block) {
+        if (colwise_recipe.use_2d_block) {
+            if (colwise_recipe.use_rht) {
+                QUANTIZE_MXFP8_ROW_MXFP4_COL_LAUNCH(true, true, true);
+            } else {
+                QUANTIZE_MXFP8_ROW_MXFP4_COL_LAUNCH(true, true, false);
+            }
+        } else if (colwise_recipe.use_rht) {
+            QUANTIZE_MXFP8_ROW_MXFP4_COL_LAUNCH(true, false, true);
+        } else {
+            QUANTIZE_MXFP8_ROW_MXFP4_COL_LAUNCH(true, false, false);
+        }
+    } else {
+        if (colwise_recipe.use_2d_block) {
+            if (colwise_recipe.use_rht) {
+                QUANTIZE_MXFP8_ROW_MXFP4_COL_LAUNCH(false, true, true);
+            } else {
+                QUANTIZE_MXFP8_ROW_MXFP4_COL_LAUNCH(false, true, false);
+            }
+        } else if (colwise_recipe.use_rht) {
+            QUANTIZE_MXFP8_ROW_MXFP4_COL_LAUNCH(false, false, true);
+        } else {
+            QUANTIZE_MXFP8_ROW_MXFP4_COL_LAUNCH(false, false, false);
+        }
+    }
+
+#undef QUANTIZE_MXFP8_ROW_MXFP4_COL_LAUNCH
+#undef QUANTIZE_MXFP8_ROW_MXFP4_COL_ARGS
+}
+
+template void quantize_mxfp8_rowwise_mxfp4_colwise_impl<dtype::float16>(
+    const dtype::float16 *input, dtype::float8_e4m3 *rowwise_output, uint8_t *rowwise_scale,
+    dtype::float4x2_e2m1 *colwise_output, uint8_t *colwise_scale, int M, int N, int M_pad,
+    int N_pad, int rowwise_scale_stride, int colwise_scale_stride, int rowwise_scale_N,
+    int colwise_scale_N, int colwise_scale_M_pad, int colwise_scale_N_pad,
+    ScalingRecipe rowwise_recipe, ScalingRecipe colwise_recipe, hipStream_t stream);
+template void quantize_mxfp8_rowwise_mxfp4_colwise_impl<dtype::bfloat16>(
+    const dtype::bfloat16 *input, dtype::float8_e4m3 *rowwise_output, uint8_t *rowwise_scale,
+    dtype::float4x2_e2m1 *colwise_output, uint8_t *colwise_scale, int M, int N, int M_pad,
+    int N_pad, int rowwise_scale_stride, int colwise_scale_stride, int rowwise_scale_N,
+    int colwise_scale_N, int colwise_scale_M_pad, int colwise_scale_N_pad,
+    ScalingRecipe rowwise_recipe, ScalingRecipe colwise_recipe, hipStream_t stream);
+
 template <typename DType>
 void quantize_mxfp4_impl(const DType *input, dtype::float4x2_e2m1 *output, uint8_t *scale,
                          QuantizeMode mode, int G, int M, int N, int M_pad, int N_pad,
