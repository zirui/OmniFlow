+        col_2d,
+        False,
+        col_rht,
+        False,
+        False,
+        shuffle_scale,
+        shuffle_data,
+    )
+
+    for fused, reference in zip(actual, (*fp8_ref, *fp4_dual_ref[2:])):
+        torch.testing.assert_close(fused.view(torch.uint8), reference.view(torch.uint8), atol=0, rtol=0)
