FROM zirui3/primus-v26.3-flux:v0.4

ARG PRIMUS_TURBO_REVISION=220ead50861860f47161787694319f4b0853df3a

COPY examples/mlperf/flux1/patches/0001-Add-fused-MXFP8-row-MXFP4-column-quantization.patch /tmp/mixed-quant.patch

RUN git clone --recursive https://github.com/AMD-AGI/Primus-Turbo.git /tmp/Primus-Turbo && \
    git -C /tmp/Primus-Turbo checkout "${PRIMUS_TURBO_REVISION}" && \
    git -C /tmp/Primus-Turbo submodule update --init --recursive && \
    git -C /tmp/Primus-Turbo apply --check /tmp/mixed-quant.patch && \
    git -C /tmp/Primus-Turbo apply /tmp/mixed-quant.patch && \
    /opt/venv/bin/python - <<'PY'
from pathlib import Path

path = Path("/tmp/Primus-Turbo/csrc/kernels/quantization/quantization_mxfp4.cu")
source = path.read_text()
old = "int val_to_add     = 1 << (hp_mbits - mbits - 1);"
new = "int val_to_add     = 3 << (hp_mbits - mbits - 3);"
if source.count(old) != 1:
    raise RuntimeError(f"Expected one MXFP4 scale expression, found {source.count(old)}")
path.write_text(source.replace(old, new))
PY
RUN GPU_ARCHS=gfx950 \
    ROCSHMEM_HOME=/tmp/rocshmem-not-installed \
    /opt/venv/bin/python -m pip install --no-build-isolation --no-deps --force-reinstall /tmp/Primus-Turbo && \
    rm -rf /tmp/Primus-Turbo

RUN /opt/venv/bin/python - <<'PY'
from pathlib import Path

import torch

extension = next(Path("/opt/venv/lib/python3.12/site-packages/primus_turbo/pytorch").glob("_C*.so"))
torch.ops.load_library(str(extension))
assert torch.ops.primus_turbo_cpp_extension.quantize_mxfp4_dual
assert torch.ops.primus_turbo_cpp_extension.quantize_mxfp4
assert torch.ops.primus_turbo_cpp_extension.quantize_mxfp8
assert torch.ops.primus_turbo_cpp_extension.quantize_mxfp8_rowwise_mxfp4_colwise
PY

LABEL com.amd.primus.mxfp4-scale-policy="uos_7p25"
LABEL com.amd.primus-turbo.revision="${PRIMUS_TURBO_REVISION}"
LABEL com.amd.primus-turbo.mixed-quant-revision="a58e3d9e1ea9602ebf2f3d4553d8e6bffaa21030"

CMD ["/usr/bin/bash"]
